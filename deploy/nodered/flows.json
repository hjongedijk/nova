[
  {
    "id": "nova-health-heartbeat",
    "type": "tab",
    "label": "NOVA health heartbeat",
    "disabled": false,
    "info": "Checks NOVA every minute and reports recovery through the authenticated event ingress."
  },
  {
    "id": "nova-health-timer",
    "type": "inject",
    "z": "nova-health-heartbeat",
    "name": "Check NOVA every minute",
    "props": [{ "p": "payload" }],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": 15,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 120,
    "wires": [["nova-health-get"]]
  },
  {
    "id": "nova-health-get",
    "type": "http request",
    "z": "nova-health-heartbeat",
    "name": "Read NOVA health",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://nova:8080/api/nova/health",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "x": 410,
    "y": 120,
    "wires": [["nova-health-transition"]]
  },
  {
    "id": "nova-health-transition",
    "type": "function",
    "z": "nova-health-heartbeat",
    "name": "Remember NOVA availability",
    "func": "const online = Number(msg.statusCode) >= 200 && Number(msg.statusCode) < 300;\nconst previous = flow.get('novaOnline');\nflow.set('novaOnline', online);\nif (online && previous === false) {\n    msg.payload = { type: 'alert', title: 'NOVA weer bereikbaar', detail: 'De heartbeat was eerder mislukt; de NOVA API reageert weer.', severity: 'info' };\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 670,
    "y": 120,
    "wires": [["nova-health-token"]]
  },
  {
    "id": "nova-health-catch",
    "type": "catch",
    "z": "nova-health-heartbeat",
    "name": "NOVA unavailable",
    "scope": ["nova-health-get"],
    "uncaught": false,
    "x": 400,
    "y": 220,
    "wires": [["nova-health-mark-offline"]]
  },
  {
    "id": "nova-health-mark-offline",
    "type": "function",
    "z": "nova-health-heartbeat",
    "name": "Remember outage",
    "func": "flow.set('novaOnline', false);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 670,
    "y": 220,
    "wires": []
  },
  {
    "id": "nova-health-token",
    "type": "function",
    "z": "nova-health-heartbeat",
    "name": "Use configured event token",
    "func": "const token = env.get('NODE_RED_EVENT_TOKEN');\nif (typeof token !== 'string' || token.length < 32) return null;\nmsg.headers = { authorization: 'Bearer ' + token, 'content-type': 'application/json' };\nmsg.url = 'http://nova:8080/api/integrations/node-red/events';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 930,
    "y": 120,
    "wires": [["nova-health-post"]]
  },
  {
    "id": "nova-health-post",
    "type": "http request",
    "z": "nova-health-heartbeat",
    "name": "Report recovery to NOVA",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "x": 1190,
    "y": 120,
    "wires": [[]]
  }
]
