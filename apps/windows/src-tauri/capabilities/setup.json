{
  "identifier": "setup",
  "description": "The local NOVA app window owns settings, pairing, the firewall rule and signed updates. Remote pages receive none of these commands.",
  "windows": ["setup"],
  "permissions": [
    "allow-desk-set-url",
    "allow-agent-setup-info",
    "allow-agent-pair-code",
    "allow-agent-configure-network",
    "allow-agent-retire-legacy",
    "allow-agent-import-legacy",
    "allow-agent-update-status",
    "allow-agent-check-update",
    "allow-agent-install-update",
    "allow-app-state",
    "allow-app-set-mode",
    "allow-app-set-helper-display",
    "allow-app-set-wallpaper",
    "allow-app-set-helper-visible",
    "allow-app-show-login",
    "allow-app-open-browser",
    "allow-app-set-autostart",
    "allow-app-set-paused",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
