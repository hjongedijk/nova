{
  "identifier": "setup",
  "description": "Local setup owns pairing, permissions, elevation and signed updates. Remote pages receive none of these commands.",
  "windows": ["setup"],
  "permissions": [
    "allow-desk-set-url",
    "allow-agent-setup-info",
    "allow-agent-pair-code",
    "allow-agent-configure-network",
    "allow-agent-retire-legacy",
    "allow-agent-import-legacy",
    "allow-agent-update-status",
    "allow-agent-check-update",
    "allow-agent-install-update",
    "allow-agent-set-automation",
    "allow-agent-set-elevation",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
