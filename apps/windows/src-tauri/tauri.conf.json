{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA for Windows",
  "version": "0.1.1",
  "identifier": "nl.nova.windows",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "shortDescription": "NOVA voor Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Dutch"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQ0NBMTlBRTcwNTJDQUEKUldTcUxBWG5tcUhNSUpoZ3d2RWJIS2JrV0Zsbkp4eDBBTFhqcllBR0pXY2xGNVZzL20wUEc4MUgK",
      "endpoints": [
        "https://github.com/hjongedijk/nova/releases/download/windows-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
