{
  "name": "@nova/web",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA interface: SvelteKit, built to static files that the API serves.",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@nova/contracts": "*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  }
}
