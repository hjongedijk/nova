# Copy to .env next to deploy/docker-compose.yml (production), or export it into your shell for development
# (NOVA does not read .env itself). Secrets have no default. In production the internal addresses are set by
# docker-compose and need no value here. Every variable is explained in docs/configuration.md.

# ── Release ──
NOVA_OWNER=hjongedijk
NOVA_VERSION=latest
# Address behind your reverse proxy, e.g. https://nova.example.com. Links then carry no port numbers.
NOVA_PUBLIC_URL=
# Optional PIN for the settings screen.
NOVA_ADMIN_PIN=
# Optional app-wide access token; use a long random value. Enables a 12-hour browser session.
NOVA_APP_TOKEN=
# Set true only when your authenticated reverse proxy protects every route.
# Leave NOVA_APP_TOKEN empty to avoid a second NOVA unlock behind that proxy.
NOVA_REVERSE_PROXY_AUTH=false
# Default voice for TTS when a browser has no local voice preference.
TTS_VOICE=nl-NL-FennaNeural
# Optional private Piper service; leave blank to use the built-in Edge voices.
NOVA_PIPER_TTS_URL=
TZ=Europe/Amsterdam

# ── AI through OmniRoute (free models only) ──
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
OMNIROUTE_ADMIN_PASSWORD=
FREE_ONLY=true
# Set to lite to use OmniRoute's lite compression header.
NOVA_OMNIROUTE_COMPRESSION=off
# 1 to 16
NOVA_MAX_TOOL_ITERATIONS=8
NOVA_DEFAULT_LANGUAGE=nl-NL

# ── Actions ──
NOVA_ENABLE_ACTIONS=false
NOVA_AUTO_EXECUTE_SAFE_ACTIONS=true
NOVA_TOOL_TIMEOUT_MS=30000

# ── Memory ──
NOVA_MEMORY_BACKEND=qdrant
# New installations. Preserve the existing namespace when upgrading indexed data.
QDRANT_COLLECTION=nova_memory
QDRANT_API_KEY=
# Optional. Embeddings still use the verified OmniRoute account key; a different key is rejected.
EMBEDDING_GATEWAY_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_FREE_VERIFIED=false

# ── Node-RED callbacks and read-only proactive briefings ──
# Generate a private token with: openssl rand -hex 32
NODE_RED_EVENT_TOKEN=
# Optional outbound flow triggers. Optional tabId maps a trigger to its Settings flow row.
# Keep the allowlist as one-line JSON; never put tokens in it.
NODE_RED_FLOW_ALLOWLIST=[]
OPENROUTESERVICE_API_KEY=
NODE_RED_FLOW_TOKEN=
# Optional server-only Node-RED Admin API bearer token; inventory needs flows.read,
# confirmed flow status/alert changes need flows.write; palette needs nodes.read/nodes.write.
NODE_RED_ADMIN_TOKEN=
# Optional approved palette packages; [] disables changes.
# Prefer records with exact name/version (see docs/node-red-palette.md).
# Legacy package-name strings still request the current npm release without a pin.
NODE_RED_PALETTE_ALLOWLIST=[]
# Optional browser-reachable editor URL; production keeps the editor internal unless explicitly exposed.
NODE_RED_EDITOR_URL=

# NOVA-to-container-broker authentication. Generate with: openssl rand -hex 32
# Required only for container status and confirmed single-service restarts.
# Save the output in this variable in the deployment .env; do not commit it.
NOVA_STACK_CONTROL_TOKEN=

# ── Proxmox ──
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true

# ── Home Assistant ──
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HOME_ASSISTANT_TOKEN=

# ── Optional private CalDAV calendar (read-only) ──
# Configure in PIN-protected Settings, or set these as private deployment defaults.
# Never commit real values or put credentials in calendar events.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Optional read-only IMAP MCP. Configure in PIN-protected Settings or set private host defaults.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ── Optional owner-selected public RSS sources ──
# JSON array, at most five: [{"name":"NOS","url":"https://feeds.nos.nl/nosnieuwsalgemeen"}]
# Targets are checked again at fetch time; local/private addresses and redirects to them are blocked.
NOVA_NEWS_FEEDS=[]

# ── Optional urgent phone notifications via a private ntfy topic ──
# Use a unique, access-controlled topic and a publish token; NOVA sends critical alert titles only.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# ── Windows PC agent (agents/windows): programs, wallpaper and the browser tools ──
WINDOWS_AGENT_URL=
WINDOWS_AGENT_TOKEN=

# ── Termix (SSH hosts) ──
TERMIX_URL=
TERMIX_API_KEY=

# ── Pangolin ──
PANGOLIN_URL=
PANGOLIN_HOST=
PANGOLIN_API_KEY=
PANGOLIN_ORG_ID=
PANGOLIN_INSECURE_TLS=false

# ── Optional extras (defaults shown or empty) ──
# NOVA_CHECK_TARGETS=nas=tcp://192.168.1.20:445,router=http://192.168.1.1/
# NOVA_HOME_LAT=
# NOVA_HOME_LON=
# NODE_EXPORTER_URL=http://host.docker.internal:9100
# NOVA_EXTENSIONS=true
# NOVA_MCP_CONFIG=/path/to/mcp-servers.json
