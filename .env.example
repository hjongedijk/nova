# Copy to .env next to deploy/docker-compose.yml. Only what must exist before NOVA starts, or is shared with
# other containers, lives here; everything else is set in NOVA's Settings (a value saved there wins over .env).
# Secrets have no default. Optional extras and the full list: docs/configuration.md.

# Image tag to run (see docs/getting-started.md for updates).
NOVA_VERSION=latest
# Address behind your reverse proxy, e.g. https://nova.example.com. Links then carry no port numbers.
NOVA_PUBLIC_URL=
# Shared with the Node-RED and Home Assistant containers.
TZ=Europe/Amsterdam

# ── AI (bootstrap: the AI must work before Settings can be used) ──
OMNIROUTE_API_KEY=
OMNIROUTE_ADMIN_PASSWORD=

# ── Secrets shared with other containers. Generate each with: openssl rand -hex 32 ──
# NOVA <-> stack-control broker (container status and restarts).
NOVA_STACK_CONTROL_TOKEN=
# Node-RED flows call back into NOVA, and NOVA triggers allow-listed flows.
NODE_RED_EVENT_TOKEN=
NODE_RED_FLOW_TOKEN=
# Optional free OpenRouteService key; Node-RED flows read it too.
OPENROUTESERVICE_API_KEY=
