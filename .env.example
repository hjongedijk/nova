# Copy to .env next to deploy/docker-compose.yml (production), or export it into your shell for development
# (NOVA does not read .env itself). Secrets have no default. In production the internal addresses are set by
# docker-compose and need no value here. Every variable is explained in docs/configuration.md.

# ── Release ──
NOVA_OWNER=hjongedijk
NOVA_VERSION=latest
# Address behind your reverse proxy, e.g. https://nova.example.com. Links then carry no port numbers.
NOVA_PUBLIC_URL=
# Optional PIN for the settings screen.
NOVA_ADMIN_PIN=
TZ=Europe/Amsterdam

# ── AI through OmniRoute (free models only) ──
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
OMNIROUTE_ADMIN_PASSWORD=
FREE_ONLY=true
# 1 to 16
JARVIS_MAX_TOOL_ITERATIONS=8
JARVIS_DEFAULT_LANGUAGE=nl-NL

# ── Actions ──
JARVIS_ENABLE_ACTIONS=false
JARVIS_AUTO_EXECUTE_SAFE_ACTIONS=true
JARVIS_TOOL_TIMEOUT_MS=30000

# ── Memory ──
JARVIS_MEMORY_BACKEND=qdrant
QDRANT_COLLECTION=jarvis_memory
QDRANT_API_KEY=
EMBEDDING_GATEWAY_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_FREE_VERIFIED=false

# ── Proxmox ──
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true

# ── Home Assistant ──
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HOME_ASSISTANT_TOKEN=

# ── Windows PC agent (agents/windows): programs, wallpaper and the browser tools ──
WINDOWS_AGENT_URL=
WINDOWS_AGENT_TOKEN=

# ── Termix (SSH hosts) ──
TERMIX_URL=
TERMIX_API_KEY=

# ── Pangolin ──
PANGOLIN_URL=
PANGOLIN_HOST=
PANGOLIN_API_KEY=
PANGOLIN_ORG_ID=
PANGOLIN_INSECURE_TLS=false

# ── Node-RED (optional: only for your own flows) ──
JARVIS_TOOL_SHARED_SECRET=

# ── Optional extras (defaults shown or empty) ──
# JARVIS_CHECK_TARGETS=nas=tcp://192.168.1.20:445,router=http://192.168.1.1/
# JARVIS_HOME_LAT=
# JARVIS_HOME_LON=
# NODE_EXPORTER_URL=http://host.docker.internal:9100
# JARVIS_EXTENSIONS=true
# JARVIS_OMNIROUTE_COMPRESSION=off
